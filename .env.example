# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA deve ser versionado.

# Banco de dados (valores de desenvolvimento local)
POSTGRES_USER=previsor
POSTGRES_PASSWORD=previsor
POSTGRES_DB=previsor
DATABASE_URL=postgres://previsor:previsor@db:5432/previsor

# Redis
REDIS_URL=redis://redis:6379/0

# Django
# Em produção, gere uma chave longa (também assina os tokens JWT):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-com-o-comando-acima
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens do front-end autorizadas a chamar a API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# WhatsApp (código de confirmação do cadastro), via Evolution API v2
# "console": a mensagem aparece no terminal do runserver.
# "evolution": envio real. Troque depois de conectar o WhatsApp no painel (http://localhost:8080/manager).
WHATSAPP_BACKEND=console
# Evolution API do Dev Container (serviço "evolution" do docker-compose)
EVOLUTION_API_URL=http://evolution:8080
# Nome da instância criada no painel e conectada ao WhatsApp do sawa
EVOLUTION_INSTANCE=sawa
# Igual a AUTHENTICATION_API_KEY do docker-compose (chave de desenvolvimento local)
EVOLUTION_API_KEY=sawa-dev-evolution-key

# Celery: True roda as tarefas na hora (sem worker), útil em desenvolvimento.
CELERY_TASK_ALWAYS_EAGER=True

# Logs: [NÍVEL ~ DD-MM-AAAA | HH:MM:SS] local.da.funcao - mensagem (veja backend/config/tracing.py)
# Nível mínimo no terminal: TRACE, DEBUG, INFO, WARNING ou ERROR. Padrão: TRACE com DEBUG=True, senão INFO.
LOG_LEVEL=TRACE
# Devolve os logs de cada requisição ao navegador (cabeçalho X-Trace), para ver o caminho
# dela no console do front-end. Expõe o funcionamento interno da API: só em dev ou demonstração.
TRACE_TO_CLIENT=True

# Front-end (Next.js) — coloque em frontend/.env.local
# Endereço da API Django. Vazio = o front usa dados de exemplo (frontend/src/lib/api/mocks.ts).
NEXT_PUBLIC_API_URL=
# Nível mínimo dos logs no console do navegador: trace, debug, info, warning, error ou silent.
# Padrão: trace em desenvolvimento, warning em produção.
NEXT_PUBLIC_LOG_LEVEL=trace
